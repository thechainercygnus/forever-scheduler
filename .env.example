# Copy to .env and fill in. .env is gitignored; never commit it.

# The bot's token, from the Discord developer portal (Bot tab).
DISCORD_TOKEN=

# Optional: server ids to register commands in straight away while developing, as a JSON
# list. Left out, commands are global and can take a while to appear.
# DEV_GUILD_IDS=[123456789012345678]

# Optional, for later (character-planner#265): the planner's address and integration token.
# PLANNER_URL=https://planner.example.com
# PLANNER_TOKEN=
